    <worksheet name='RFM Customer Breakdown'>
      <layout-options>
        <title>
          <formatted-text>
            <run>RFM Segment Breakdown</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/CustomerSegmentRetention?rev=' id='CustomerSegmentRetention' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='RFM Anchor Date' datatype='datetime' name='[Calculation_0013880608641163]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_purchase_timestamp] END)}' />
            </column>
            <column caption='RFM Customer Count' datatype='integer' name='[Calculation_0013880610676877]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND NOT ISNULL([order_id (fact_orderitems.csv)])&#10;    THEN [customer_unique_id]&#10;    END)' />
            </column>
            <column caption='Recency Days' datatype='integer' name='[Calculation_1896722372538368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_unique_id] : MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_purchase_timestamp] END)},&#10;[Calculation_0013880608641163])' />
            </column>
            <column caption='Order Frequency' datatype='integer' name='[Calculation_1896722373836801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_unique_id] : COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_id (fact_orderitems.csv)] END)}' />
            </column>
            <column caption='Lifetime Spend' datatype='real' name='[Calculation_1896722374057986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_unique_id] : SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] + [freight_value] END)}' />
            </column>
            <column caption='RFM Customer Segment' datatype='string' name='[Calculation_1896722374512643]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1896722373836801] &gt;= 2 AND [Calculation_1896722374057986] &gt;= 300 THEN&#10;&apos;Champions &amp; VIPs&apos;&#10;ELSEIF [Calculation_1896722373836801] &gt;= 2 THEN&#10;&apos;Loyal Repeat Customers&apos;&#10;ELSEIF [Calculation_1896722372538368] &lt;= 180 AND [Calculation_1896722374057986] &gt;= 300 THEN&#10;&apos;High-Value Single Buyers&apos;&#10;ELSEIF [Calculation_1896722372538368] &lt;= 180 THEN&#10;&apos;Recent Standard Buyers&apos;&#10;ELSE&#10;&apos;Lapsed / At-Risk Buyers&apos;&#10;END' />
            </column>
