      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/BAN-LiquidityRatio?rev=' id='BAN-LiquidityRatio' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Current Year Instant Volume' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014355632611411]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;   AND [payment_type] IN (&apos;debit_card&apos;, &apos;voucher&apos;) &#10;THEN [payment_value] &#10;END' />
            </column>
            <column caption='Previous Year Instant Volume' datatype='real' name='[Calculation_0014355632705620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)&#10;   AND [payment_type] IN (&apos;debit_card&apos;, &apos;voucher&apos;) &#10;THEN [payment_value] &#10;END' />
            </column>
            <column caption='Current Year Instant Cash Ratio' datatype='real' name='[Calculation_0014355632906325]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0014355632611411]) / SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [payment_value] END)' />
            </column>
            <column caption='Previous Year Instant Cash Ratio ' datatype='real' name='[Calculation_0014355633008726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0014355632705620]) / SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) THEN [payment_value] END)' />
            </column>
            <column caption='YoY Instant Cash Ratio % Change' datatype='real' name='[Calculation_0014355633143895]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN &#10;    NULL &#10;ELSE &#10;    ([Calculation_0014355632906325] - [Calculation_0014355633008726]) &#10;    / [Calculation_0014355633008726]&#10;END' />
            </column>
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal'>
