          <layout-options>
            <title>
              <formatted-text>
                <run bold='true' fontcolor='#1b1b1b' fontsize='18'>E-COMMERCE EXECUTIVE DASHBOARD</run>
                <run>Æ&#10;</run>
                <run bold='true' fontcolor='#1b1b1b' fontsize='12'>Financial Performance</run>
              </formatted-text>
            </title>
          </layout-options>
          <size maxheight='3750' minheight='3750' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='921' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='84000' id='920' param='vert' type-v2='layout-flow' w='84000' x='8000' y='8000'>
                <zone h='7491' id='731' type-v2='dashboard-object' w='4219' x='995' y='1930'>
