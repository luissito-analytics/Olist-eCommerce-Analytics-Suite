            </column>
            <column caption='Current Year Delayed Orders Count' datatype='integer' name='[Calculation_0014567520432134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_purchase_timestamp])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND NOT ISNULL([order_delivered_carrier_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id]&#10;    END&#10;)' />
            </column>
            <column caption='State Title Display' datatype='string' name='[Calculation_0014700932206595]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([customer_state]) = MAX([customer_state])&#10;THEN MIN([customer_state])&#10;ELSE &quot;All States (Brazil)&quot;&#10;END' />
            </column>
            <column caption='Dummy' datatype='string' name='[Calculation_0014700942684168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Dummy&quot;' />
            </column>
            <column caption='Delay Root Cause' datatype='string' name='[Calculation_0014975493361865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN &#10;&#9;IF [order_delivered_carrier_date] &gt; [order_estimated_delivery_date] THEN&#10;    &#9;&quot;Seller Dispatch Delay&quot;&#10;    ELSE&#10;        &quot;Carrier Transit Delay&quot;&#10;    END&#10;ELSE&#10;&#9;&quot;On-Time&quot;&#10;END' />
