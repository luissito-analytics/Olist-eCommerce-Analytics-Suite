      </column>
      <column caption='Delivery Delay Bucket' datatype='string' name='[Calculation_2933012402483209]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date]) THEN &quot;Not Delivered&quot;&#10;ELSEIF [order_delivered_customer_date] &lt;= [order_estimated_delivery_date] THEN &quot;On Time/Early&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date]) &lt;= 3 THEN &quot;1-3 Days Late&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date]) &lt;= 7 THEN &quot;4-7 Days Late&quot;&#10;ELSE &quot;8+ Days Late&quot;&#10;END' />
      </column>
      <column caption='Current Year Total Orders Distinct' datatype='integer' name='[Calculation_2933012404740106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;THEN [order_id] END)' />
      </column>
      <column caption='Average CSAT per State' datatype='real' name='[Calculation_2933012416602124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos;&#10;THEN [review_score] END)' />
      </column>
      <column caption='% 1-Star Friction' datatype='real' name='[Calculation_2933012428931085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [review_score] = 1 AND YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos; THEN [review_id] END)&#10;/&#10;COUNTD(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos; THEN [review_id] END)' />
      </column>
      <column caption='CY Net Cash Realization Rate' datatype='real' name='[Calculation_6315042978185216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos;&#10;THEN&#10;{FIXED [order_id]: SUM(IF [payment_type] &lt;&gt; &apos;voucher&apos; THEN [payment_value] ELSE 0 END)}&#10;* ([price] + [freight_value])&#10;/{FIXED [order_id]: SUM([price] + [freight_value])}&#10;END)&#10;/&#10;SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos;&#10;THEN [price] + [freight_value]&#10;END&#10;)' />
      </column>
      <column caption='PY Net Cash Realization Rate' datatype='real' name='[Calculation_6315042978947073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) AND [order_status] = &apos;delivered&apos;&#10;THEN&#10;{FIXED [order_id]: SUM(IF [payment_type] &lt;&gt; &apos;voucher&apos; THEN [payment_value] ELSE 0 END)}&#10;* ([price] + [freight_value])&#10;/ {FIXED [order_id]: SUM([price] + [freight_value])}&#10;END)&#10;/&#10;SUM(&#10;IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;delivered&apos;&#10;THEN [price] + [freight_value]&#10;END&#10;)' />
      </column>
      <column caption='YoY Net Cash Realization Rate' datatype='real' name='[Calculation_6315042980003842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE ([Calculation_6315042978185216] - [Calculation_6315042978947073]) / [Calculation_6315042978947073]&#10;END' />
      </column>
      <column caption='Dynamic Dataset Caveat Note' datatype='string' name='[Calculation_6315043240337411]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0014559299325996] = 2018 THEN&#10;&quot;*Note: Dataset order intake concludes in August 2018; Sept - Oct reflects trailing deliveries.&quot;&#10;ELSEIF [Parameters].[Parameter 0014559299325996] = 2016 THEN&#10;&quot;*Note: Historical Archive begins Sept 2016 with sparse initial staging volume.&quot;&#10;ELSE &quot;&quot;&#10;END' />
      </column>
