    <worksheet name='BAN - Net Cash Realization Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' italic='true'>Net Cash Realization Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='CY Net Cash Realization Rate' datatype='real' name='[Calculation_6315042978185216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos;&#10;THEN&#10;{FIXED [order_id]: SUM(IF [payment_type] &lt;&gt; &apos;voucher&apos; THEN [payment_value] ELSE 0 END)}&#10;* ([price] + [freight_value])&#10;/{FIXED [order_id]: SUM([price] + [freight_value])}&#10;END)&#10;/&#10;SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos;&#10;THEN [price] + [freight_value]&#10;END&#10;)' />
            </column>
            <column caption='PY Net Cash Realization Rate' datatype='real' name='[Calculation_6315042978947073]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) AND [order_status] = &apos;delivered&apos;&#10;THEN&#10;{FIXED [order_id]: SUM(IF [payment_type] &lt;&gt; &apos;voucher&apos; THEN [payment_value] ELSE 0 END)}&#10;* ([price] + [freight_value])&#10;/ {FIXED [order_id]: SUM([price] + [freight_value])}&#10;END)&#10;/&#10;SUM(&#10;IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;delivered&apos;&#10;THEN [price] + [freight_value]&#10;END&#10;)' />
            </column>
            <column caption='YoY Net Cash Realization Rate' datatype='real' name='[Calculation_6315042980003842]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE ([Calculation_6315042978185216] - [Calculation_6315042978947073]) / [Calculation_6315042978947073]&#10;END' />
            </column>
            <column caption='Freight Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[freight_value]' role='measure' type='quantitative' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;boleto&quot;' value='Boleto Bancário' />
                <alias key='&quot;credit_card&quot;' value='Credit Card' />
                <alias key='&quot;debit_card&quot;' value='Debit Card' />
                <alias key='&quot;voucher&quot;' value='Voucher' />
              </aliases>
            </column>
            <column caption='Payment Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[payment_value]' role='measure' type='quantitative' />
            <column caption='Price' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6315042978185216]' derivation='User' name='[usr:Calculation_6315042978185216:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6315042980003842]' derivation='User' name='[usr:Calculation_6315042980003842:qk]' pivot='key' type='quantitative' />
