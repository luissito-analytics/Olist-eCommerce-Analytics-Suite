      <column caption='Previous Year OTIF Rate' datatype='real' name='[Calculation_0015456561229837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;&#9;AND [order_delivered_customer_date] &lt;= [order_estimated_delivery_date]&#10;    AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;    THEN [order_id] END)&#10;/&#10;COUNTD(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;    THEN [order_id] END)' />
      </column>
      <column caption='YoY OTIF Rate Change' datatype='real' name='[Calculation_0015456561373198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE ([Calculation_0015456560812044] - [Calculation_0015456561229837]) / [Calculation_0015456561229837]&#10;END' />
      </column>
      <column caption='Shipping Corridor' datatype='string' name='[Calculation_0589196809330688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[seller_state] + &quot; ➔ &quot; + [customer_state]' />
      </column>
      <column caption='Route Avg Delay Days' datatype='real' name='[Calculation_0589196809531393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    {FIXED [order_id], [Calculation_0589196809330688] : &#10;        MIN(&#10;            IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;               AND [order_status] = &apos;delivered&apos;&#10;               AND NOT ISNULL([order_delivered_customer_date])&#10;               AND NOT ISNULL([order_estimated_delivery_date])&#10;               AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;            THEN DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])&#10;            END&#10;        )&#10;    }&#10;)' />
      </column>
      <column caption='Delayed Orders Count' datatype='integer' name='[Calculation_0589196816285698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;THEN [order_id] END)' />
      </column>
      <column caption='Avg Seller Dispatch Days' datatype='real' name='[Calculation_0589196817727491]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;IF YEAR ([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_delivered_carrier_date])&#10;AND NOT ISNULL([order_purchase_timestamp])&#10;THEN DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_carrier_date])&#10;END)' />
      </column>
      <column caption='Current Year Payment Value' datatype='real' name='[Calculation_1350130400096257]' role='measure' type='quantitative'>
