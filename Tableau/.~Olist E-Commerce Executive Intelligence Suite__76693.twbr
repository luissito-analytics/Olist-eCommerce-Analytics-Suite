          <formatted-text>
            <run fontcolor='#555555' italic='true'>High-Risk Exposure Share</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/BAN-HighRiskExposureShare?rev=' id='BAN-HighRiskExposureShare' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='High Risk Exposure Share' datatype='real' default-format='p0.00%' name='[Calculation_0014975456075945]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;{FIXED [order_id]:&#10;MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [payment_type] = &apos;credit_card&apos; &#10;AND [payment_installments] &gt;= 7 &#10;AND [order_status] = &apos;delivered&apos; &#10;THEN {FIXED [order_id]: SUM([price])} &#10;ELSE 0 &#10;END&#10;)}) &#10;/ &#10;SUM(&#10;{FIXED [order_id] :&#10;MAX(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos; &#10;THEN {FIXED [order_id]: SUM([price])} END&#10;)})' />
            </column>
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Payment Installments' datatype='integer' name='[payment_installments]' role='measure' type='ordinal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;boleto&quot;' value='Boleto Bancário' />
                <alias key='&quot;credit_card&quot;' value='Credit Card' />
                <alias key='&quot;debit_card&quot;' value='Debit Card' />
                <alias key='&quot;voucher&quot;' value='Voucher' />
              </aliases>
            </column>
            <column caption='Price' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0014975456075945]' derivation='User' name='[usr:Calculation_0014975456075945:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='cell-w' value='160' />
            <format attr='cell-h' value='40' />
