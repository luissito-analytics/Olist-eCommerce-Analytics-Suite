    <worksheet name='Financial Performance Metrics Definition'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Financial Performance Metrics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Business Metrics for Executive Summary' name='federated.07c9mxh0qbxa430zqv3kl10xikwv' />
          </datasources>
          <datasource-dependencies datasource='federated.07c9mxh0qbxa430zqv3kl10xikwv'>
            <column datatype='string' name='[Business Metric Used]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Payment Realization Rate&quot;' value='Net Cash Realization Rate' />
              </aliases>
            </column>
            <column datatype='string' name='[Dashboard Use]' role='dimension' type='nominal' />
            <column datatype='string' name='[Definition]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Average review score broken down by payment length.&quot;' value='Within-tier distribution of review scores across installment brackets, calculated using distinct order counts per bracket.' />
                <alias key='&quot;Average spending per distinct order.&quot;' value='Average revenue per unique delivered order.' />
                <alias key='&quot;Combined value of merchandise sold and customer-paid shipping prior to voucher deductions.&quot;' value='Total monetary value of delivered orders within selected year, combining item prices and freight charges.' />
                <alias key='&quot;Mean calendar days elapsed from purchase to final customer delivery.&quot;' value='Mean elapsed time from order approval to carrier delivery, evaluated on delivered orders.' />
                <alias key='&quot;Mean number of installment split payments selected by buyers.&quot;' value='Mean number of installment payments across qualifying installment transactions (greater or equal to 1).' />
                <alias key='&quot;Mean score out of 5 stars submitted on post-purchase review surveys.&quot;' value='Mean customer review score across reviewed orders in the active scope.' />
                <alias key='&quot;Mean shipping fee charged per item.&quot;' value='Mean shipping fee charged per order across all orders within selected period to capture cost shifts and monthly variance.' />
                <alias key='&quot;Percentage of completed orders that generated a customer review submission.&quot;' value='Share of orders that received a submitted customer review.' />
                <alias key='&quot;Percentage of orders grouped into payment installment tiers.&quot;' value='Distribution of payment value across installment brackets where 0 installment/null cases are excluded.' />
                <alias key='&quot;Percentage of placed order value successfully collected into net accounts after voucher deductions.&quot;' value='Proportion of Order value successfully realized net of leakage and voucher/promotional reductions.' />
                <alias key='&quot;Percentage of total order value consumed by shipping costs.&quot;' value='Share of total order value (price + freight) accounted for by freight charges within the customer view.' />
                <alias key='&quot;Percentage of unique customers who completed more than one order.&quot;' value='Share of distinct customers who placed more than one order within the evaluated scope.' />
                <alias key='&quot;Proportion of orders delivered on or before the estimated delivery date.&quot;' value='Share of delivered orders fulfilled without late arrival or fulfillment failure relative to the evaluated order base.' />
                <alias key='&quot;Proportion of submitted reviews rated at 1-Star.&quot;' value='Percentage of submitted reviews rated 1-star for 1-star review count divided by total reviewed orders in scope.' />
                <alias key='&quot;Proportion of total transaction volume processed per payment type.&quot;' value='Distribution of payment value across payment methods within the year. (excluding undefined tpes and aligning with distinct order aggregation.' />
                <alias key='&quot;Pure item value of goods sold, excluding freight fees and vouchers.&quot;' value='Total merchandise sales value across delivered orders in the selected period. (excl. freight and voucher adjustments)' />
                <alias key='&quot;Share of Gross Revenue offset by voucher redemptions.&quot;' value='Proportion of merchandise value offset by voucher redemptions.' />
                <alias key='&quot;Share of item price consumed by shipping charges. Also referred as Freight Drag \%.&quot;' value='Ratio of shipping charges to order value across all order to track how heavy freight weighs on customer basket value.' />
                <alias key='&quot;Share of late delivered caused by sellers packaging past promised dispatch dates.&quot;' value='Share of late deliveries caused by sellers packaging past promised dispatch dates.' />
                <alias key='&quot;Share of late deliveries caused by logistics transit time exceeding SLA.&quot;' value='Share of late deliveries caused by carrier transit time beyond expected/estimated timelines.' />
                <alias key='&quot;Share of total payments processed immediately without clearance lag (Debit/ Instant Credit Card Approvals)&quot;' value='Share of payment value settled immediately without multi-day installment deferral or Boleto clearance lag.' />
                <alias key='&quot;Total distinct buyers with completed purchases.&quot;' value='Count of distinct customers within the filtered period and RFM segment scope.' />
                <alias key='&quot;Total lost item value from unfulfilled or cancelled orders.&quot;' value='Merchandise Value associated with cancelled/unfulfilled orders, reconciled to order greain to prevent line-item inflation.' />
                <alias key='&quot;Total promotional discount value subsidized via customer vouchers.&quot;' value='Total Value of voucher payments where payment type is voucher among delivered orders.' />
              </aliases>
            </column>
            <column-instance column='[Business Metric Used]' derivation='None' name='[none:Business Metric Used:nk]' pivot='key' type='nominal' />
            <column-instance column='[Dashboard Use]' derivation='None' name='[none:Dashboard Use:nk]' pivot='key' type='nominal' />
            <column-instance column='[Definition]' derivation='None' name='[none:Definition:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <manual-sort column='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Business Metric Used:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Gross Revenue&quot;</bucket>
              <bucket>&quot;Gross Merchandise Value (GMV)&quot;</bucket>
              <bucket>&quot;Average Freight Value&quot;</bucket>
              <bucket>&quot;Average Freight-Price Ratio&quot;</bucket>
              <bucket>&quot;Payment Method Mix Share&quot;</bucket>
              <bucket>&quot;Boleto Settlement Lag&quot;</bucket>
              <bucket>&quot;Instant Cash Ratio&quot;</bucket>
              <bucket>&quot;Installment Breakdown Share&quot;</bucket>
              <bucket>&quot;Avg. Installments Over Time&quot;</bucket>
              <bucket>&quot;High-Risk Exposure Share&quot;</bucket>
              <bucket>&quot;Cancelled Gross Merchandise Value&quot;</bucket>
              <bucket>&quot;Boleto Non-Payment Share&quot;</bucket>
              <bucket>&quot;Voucher Spend (Promo Leakage)&quot;</bucket>
              <bucket>&quot;Voucher Discount Rate&quot;</bucket>
              <bucket>&quot;Financial Leakage Rate&quot;</bucket>
              <bucket>&quot;Payment Realization Rate&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Dashboard Use:nk]'>
            <groupfilter function='member' level='[none:Dashboard Use:nk]' member='&quot;Financial&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Dashboard Use:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' value='445' />
            <format attr='height' field='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Business Metric Used:nk]' value='36' />
            <format attr='height' field='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Dashboard Use:nk]' value='23' />
          </style-rule>
          <style-rule element='header'>
            <format attr='width' field='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Business Metric Used:nk]' value='228' />
          </style-rule>
          <style-rule element='label'>
            <format attr='text-align' field='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Business Metric Used:nk]' value='center' />
            <format attr='wrap' scope='rows' value='on' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='rows' value='false' />
          </style-rule>
          <style-rule element='table-div'>
            <format attr='stroke-size' scope='rows' value='1' />
            <format attr='line-visibility' scope='rows' value='on' />
            <format attr='line-pattern-only' scope='rows' value='solid' />
            <format attr='div-level' scope='rows' value='1' />
          </style-rule>
          <style-rule element='tooltip'>
            <format attr='background-color' value='#ffffff' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Definition:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text />
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run>&lt;</run>
                <run>[federated.07c9mxh0qbxa430zqv3kl10xikwv].[none:Definition:nk]</run>
                <run>&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
