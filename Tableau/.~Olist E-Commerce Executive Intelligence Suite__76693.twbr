              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] END)' />
            </column>
            <column caption='Previous Year Merch Value' datatype='real' name='[Calculation_0014559318024247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) THEN [price] END)' />
            </column>
            <column caption='Current Year Voucher Spend' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014562526679081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [payment_type] = &apos;voucher&apos;&#10;AND [order_status] = &apos;delivered&apos;&#10;  THEN [payment_value] END)' />
            </column>
            <column caption='Previous Year Voucher Spend' datatype='real' name='[Calculation_0014562527174698]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)&#10;AND [payment_type] = &apos;voucher&apos;&#10;AND [order_status] = &apos;delivered&apos;&#10;THEN [payment_value] END)' />
            </column>
            <column caption='Current Year Voucher Discount Rate' datatype='real' name='[Calculation_0014562528309293]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0014562526679081]&#10;/&#10;[Calculation_0014559317827638]' />
            </column>
            <column caption='Previous Year Voucher Discount Rate' datatype='real' name='[Calculation_0014562541400115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0014562527174698]&#10;/&#10;[Calculation_0014559318024247]' />
            </column>
            <column caption='YoY Voucher Discount Rate' datatype='real' name='[Calculation_0014562541535284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE&#10;([Calculation_0014562528309293] - [Calculation_0014562541400115]) / [Calculation_0014562541400115]&#10;END' />
            </column>
