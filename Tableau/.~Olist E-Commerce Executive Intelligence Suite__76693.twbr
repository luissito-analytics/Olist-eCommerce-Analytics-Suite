          <zone h='2130' id='748' type-v2='text' w='24375' x='73281' y='26111'>
            <formatted-text>
              <run bold='true'>Core Analytical Modules:</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
