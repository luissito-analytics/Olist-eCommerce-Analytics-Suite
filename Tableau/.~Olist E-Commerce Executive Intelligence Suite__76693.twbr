    <worksheet name='BAN - Boleto Settlement Lag'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' italic='true'>Boleto Settlement Lag</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/BAN-BoletoSettlementLag?rev=' id='BAN-BoletoSettlementLag' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Current Boleto Lag ' datatype='integer' name='[Calculation_0014355629236304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;   AND [payment_type] = &apos;boleto&apos; &#10;THEN DATEDIFF(&apos;hour&apos;, [order_purchase_timestamp], [order_approved_at]) &#10;END' />
            </column>
            <column caption='Previous Boleto Lag' datatype='integer' name='[Calculation_0014355630616657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) &#10;   AND [payment_type] = &apos;boleto&apos; &#10;THEN DATEDIFF(&apos;hour&apos;, [order_purchase_timestamp], [order_approved_at]) &#10;END' />
            </column>
            <column caption='YoY % Boleto Lag' datatype='real' name='[Calculation_0014355630706770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN &#10;    NULL &#10;ELSE &#10;    (AVG([Calculation_0014355629236304]) - AVG([Calculation_0014355630616657])) &#10;    / AVG([Calculation_0014355630616657])&#10;END' />
            </column>
            <column-instance column='[Calculation_0014355629236304]' derivation='Avg' name='[avg:Calculation_0014355629236304:qk]' pivot='key' type='quantitative' />
            <column caption='Order Approved At' datatype='datetime' name='[order_approved_at]' role='dimension' type='ordinal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;boleto&quot;' value='Boleto Bancário' />
                <alias key='&quot;credit_card&quot;' value='Credit Card' />
                <alias key='&quot;debit_card&quot;' value='Debit Card' />
                <alias key='&quot;voucher&quot;' value='Voucher' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0014355630706770]' derivation='User' name='[usr:Calculation_0014355630706770:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='cell-w' value='160' />
            <format attr='cell-h' value='40' />
