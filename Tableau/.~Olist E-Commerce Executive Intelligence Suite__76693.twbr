      <layout-options>
        <title>
          <formatted-text>
            <run bold='false' fontcolor='#555555'>Carrier and Seller Hub Performance</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/CarrierScorecardTable?rev=' id='CarrierScorecardTable' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Hub Avg Seller Dispatch Days' datatype='real' name='[Calculation_0013880562135113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;    {FIXED [order_id], [seller_state] : &#10;        MIN(&#10;            IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;               AND [order_status] = &apos;delivered&apos;&#10;               AND NOT ISNULL([order_delivered_carrier_date])&#10;               AND NOT ISNULL([order_delivered_customer_date])&#10;               AND NOT ISNULL([order_estimated_delivery_date])&#10;            THEN DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_carrier_date])&#10;            END&#10;        )&#10;    }&#10;)' />
            </column>
            <column caption='Hub Avg Carrier Transit Days' datatype='real' name='[Calculation_0013880562516045]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;    {FIXED [order_id], [seller_state] : &#10;        MIN(&#10;            IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;               AND [order_status] = &apos;delivered&apos;&#10;               AND NOT ISNULL([order_delivered_carrier_date])&#10;               AND NOT ISNULL([order_delivered_customer_date])&#10;               AND NOT ISNULL([order_estimated_delivery_date])&#10;            THEN DATEDIFF(&apos;day&apos;, [order_delivered_carrier_date], [order_delivered_customer_date])&#10;            END&#10;        )&#10;    }&#10;)' />
            </column>
            <column caption='Dummy' datatype='string' name='[Calculation_0014700942684168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Dummy&quot;' />
            </column>
            <column caption='Hub Late Delivery Rate' datatype='real' name='[Calculation_0014700965056542]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_delivered_carrier_date])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;      THEN [order_id]&#10;      END&#10;    )&#10;/ [Calculation_0014700967469088]' />
            </column>
            <column caption='Hub Delivered Orders' datatype='integer' name='[Calculation_0014700967469088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_carrier_date])&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;  THEN [order_id]&#10;END&#10;)' />
            </column>
            <column caption='Avg Days Late / Early vs. SLA' datatype='real' name='[Calculation_0014700968230946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    THEN DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])&#10;    END&#10;)' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_0014975477141689]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='&quot;Brazil&quot;' />
            </column>
