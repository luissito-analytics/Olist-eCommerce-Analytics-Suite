        <zone forceUpdate='true' h='2778' id='625' type-v2='text' w='14115' x='5729' y='26944'>
          <formatted-text>
            <run fontcolor='#555555' fontsize='10'>Customer Satisfaction and Review Performance</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' friendly-name='Title - Business Context' h='4907' id='631' type-v2='text' w='15469' x='5781' y='47870'>
          <formatted-text>
            <run fontcolor='#555555' fontsize='15'>Business Context &amp; Project Scope</run>
          </formatted-text>
        </zone>
        <zone friendly-name='Blank - Data Dictionary' h='41852' id='636' type-v2='empty' w='75521' x='23125' y='12315'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
            <format attr='background-color' value='#f5f5f5' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' friendly-name='Title - Data Dictionary' h='2778' id='633' type-v2='text' w='18177' x='24167' y='13241'>
          <formatted-text>
            <run fontcolor='#555555' fontsize='15'>Navigation Architecture</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' friendly-name='Text - Business Context' h='11111' id='648' type-v2='text' w='14531' x='6250' y='53056'>
          <formatted-text>
            <run fontcolor='#555555'>The scope of this dashboard creation is to evaluate the E-commerce performance of the organization across financial leakage, regional fulfillment logistics, and customer sentiment drivers to determine critical areas of friction in its operations, and provide relevant recommendations accordingly.</run>
          </formatted-text>
        </zone>
        <zone friendly-name='Blank - CSAT Text' h='3611' id='683' type-v2='empty' w='15365' x='5156' y='33148'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
            <format attr='background-color' value='#f5f5f5' />
          </zone-style>
        </zone>
        <zone friendly-name='Blank - CSAT Text' h='3611' id='684' type-v2='empty' w='15365' x='5156' y='39815'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
            <format attr='background-color' value='#f5f5f5' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='2778' id='685' type-v2='text' w='14115' x='5729' y='33519'>
          <formatted-text>
            <run fontcolor='#555555' fontsize='10'>Project Scope - Data Dictionary &amp; Key Calculations</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='2778' id='686' type-v2='text' w='14115' x='5729' y='40185'>
          <formatted-text>
            <run fontcolor='#555555' fontsize='10'>Project Scope - Navigation Architecture &amp; Project Constraints</run>
          </formatted-text>
        </zone>
        <zone friendly-name='Blank - Data Dictionary' h='41852' id='687' type-v2='empty' w='75521' x='23125' y='56481'>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
            <format attr='background-color' value='#f5f5f5' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' friendly-name='Title - Data Dictionary' h='2778' id='688' type-v2='text' w='18177' x='24167' y='57407'>
          <formatted-text>
            <run fontcolor='#555555' fontsize='15'>Scope Constraints &amp; Assumptions</run>
          </formatted-text>
        </zone>
        <zone h='35278' id='697' param='vert' type-v2='layout-flow' w='16927' x='25208' y='61759'>
          <zone h='2222' id='698' type-v2='text' w='16927' x='25208' y='61759'>
            <formatted-text>
              <run bold='true' fontsize='10'>TEMPORAL &amp; DATASET BOUNDARIES</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='99' forceUpdate='true' h='9908' id='699' is-fixed='true' type-v2='text' w='16927' x='25208' y='63981'>
            <formatted-text>
              <run bold='true'>Reporting Period Focus: </run>
              <run>Primary dashboard views are filtered to 2018 (Through October 2018, where the Olist public dataset concludes) to evaluate full-year operational and financial performance against 2017 baselines.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='108' forceUpdate='true' h='10741' id='700' is-fixed='true' type-v2='text' w='16927' x='25208' y='73889'>
            <formatted-text>
              <run bold='true'>Year-over-Year (YoY) Benchmarking: </run>
              <run>Prior-year percentage variances compare equivalent active months in 2018 against 2017 to prevent partial-year distortion in Q4. Variances from 2016 against 2017 are not covered given the lack of full-year performance in said period.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='93' forceUpdate='true' h='9352' id='701' is-fixed='true' type-v2='text' w='16927' x='25208' y='84630'>
            <formatted-text>
              <run bold='true'>RFM Snapshot Anchor: </run>
              <run>Recency calculations are anchored to the maximum order purchase timestamp in the dataset rather than the current calendar date, ensuring accurate customer lifecycle classification.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='35278' id='702' param='vert' type-v2='layout-flow' w='16927' x='43333' y='61759'>
          <zone forceUpdate='true' h='2222' id='703' type-v2='text' w='16927' x='43333' y='61759'>
            <formatted-text>
              <run bold='true' fontsize='10'>FINANCIAL &amp; REVENUE RECOGNITION LOGIC</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='101' forceUpdate='true' h='10093' id='704' is-fixed='true' type-v2='text' w='16927' x='43333' y='63981'>
            <formatted-text>
              <run bold='true'>Gross vs. Net Demand Separation: </run>
              <run>Gross Revenue </run>
              <run italic='true'>(calculated as Price + Freight Value) </run>
              <run>is calculated prior to voucher deductions to measure true commercial demand, while Payment Value reflects net cash realized after promotional offsets.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='91' forceUpdate='true' h='9167' id='705' is-fixed='true' type-v2='text' w='16927' x='43333' y='74074'>
            <formatted-text>
              <run bold='true'>Currency Standardization:  </run>
              <run>All monetary figures are reported in Brazilian Real (R$) without inflation or exchange-rate adjustments.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='121' forceUpdate='true' h='11945' id='706' is-fixed='true' type-v2='text' w='16927' x='43333' y='83241'>
            <formatted-text>
              <run bold='true'>Cancellation &amp; Leakage Scope:  </run>
              <run>Financial leakage tracks orders explicitly flagged as </run>
              <run italic='true'>cancelled </run>
              <run>or </run>
              <run italic='true'>unavailable</run>
              <run>, as well as Boleto Bancário orders that timed out prior to payment approval.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='35278' id='707' param='vert' type-v2='layout-flow' w='16927' x='61354' y='61759'>
          <zone forceUpdate='true' h='2222' id='708' type-v2='text' w='16927' x='61354' y='61759'>
            <formatted-text>
              <run bold='true' fontsize='10'>OPERATIONAL &amp; LOGISTICS RULES</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='100' forceUpdate='true' h='10000' id='709' is-fixed='true' type-v2='text' w='16927' x='61354' y='63981'>
            <formatted-text>
              <run bold='true'>Fulfillment Scope:  </run>
              <run>Delivery performance metrics (Late Delivery Rate, OTIF, Transit Days) are calculated exclusively on orders with a delivered status and valid customer delivery timestamps.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='117' forceUpdate='true' h='11574' id='710' is-fixed='true' type-v2='text' w='16927' x='61354' y='73981'>
            <formatted-text>
              <run bold='true'>Delay Attribution:  </run>
              <run>Late deliveries are partitioned into </run>
              <run italic='true'>Seller</run>
              <run bold='true'>Æ </run>
              <run italic='true'>Dispatch</run>
              <run bold='true'>Æ </run>
              <run italic='true'>Delay</run>
              <run bold='true'>Æ </run>
              <run>(carrier handoff occurred after the seller&apos;s promised shipping limit date) versus </run>
              <run italic='true'>Carrier Transit Delay</run>
              <run bold='true'>Æ </run>
              <run>(seller dispatched on time, but transit exceeded the customer&apos;s estimated delivery date).</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='84' forceUpdate='true' h='8519' id='711' is-fixed='true' type-v2='text' w='16927' x='61354' y='85555'>
            <formatted-text>
              <run bold='true'>Geographic Granularity:  </run>
              <run>Regional bottlenecks are evaluated at the Brazilian Federal Unit (State) level based on customer shipping destination (via Customer State) for delivery friction and seller origin (via Seller State) for hub performance.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='35278' id='712' param='vert' type-v2='layout-flow' w='16927' x='79688' y='61759'>
          <zone forceUpdate='true' h='3704' id='713' type-v2='text' w='16927' x='79688' y='61759'>
            <formatted-text>
              <run bold='true' fontsize='10'>CUSTOMER SATISFACTION &amp; SEGMENTATION ASSUMPTIONS</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='89' forceUpdate='true' h='8982' id='714' is-fixed='true' type-v2='text' w='16927' x='79688' y='65463'>
            <formatted-text>
              <run bold='true'>Survey Attribution:  </run>
              <run>CSAT and 1-Star Friction metrics reflect only orders where a post-purchase customer review was submitted; unreviewed orders are excluded from rating averages rather than imputed.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='91' forceUpdate='true' h='9167' id='715' is-fixed='true' type-v2='text' w='16927' x='79688' y='74445'>
            <formatted-text>
              <run bold='true'>Unique Customer Identity:  </run>
              <run>Repeat purchase rates and RFM metrics aggregate order history by </run>
              <run italic='true'>customer_unique_id  </run>
              <run>instead of customer_id</run>
              <run italic='true'> to accurately track returning buyers.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='94' forceUpdate='true' h='9445' id='716' is-fixed='true' type-v2='text' w='16927' x='79688' y='83612'>
            <formatted-text>
              <run bold='true'>Product Category Naming:  </run>
              <run>Portugese product category names are mapped to their standardized English translations, with uncategorized items grouped or excluded from Top/Bottom 5 rankings.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='34907' id='717' param='vert' type-v2='layout-flow' w='22552' x='24531' y='16944'>
          <zone forceUpdate='true' h='2593' id='720' type-v2='text' w='22552' x='24531' y='16944'>
            <formatted-text>
              <run bold='true' fontsize='12'>FINANCIAL SUMMARY AND PERFORMANCE</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='62' forceUpdate='true' h='6482' id='729' is-fixed='true' type-v2='text' w='22552' x='24531' y='19537'>
            <formatted-text>
              <run bold='true'>Strategic Objective:  </run>
              <run>Evaluates top-line commercial demand, payment method behavior, working capital exposure, and revenue leakage across the order lifecycle.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='2130' id='730' type-v2='text' w='22552' x='24531' y='26019'>
            <formatted-text>
              <run bold='true'>Core Analytical Modules:</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='199' h='18426' id='732' is-fixed='true' param='horz' type-v2='layout-flow' w='22552' x='24531' y='28149'>
            <zone fixed-size='24' h='18426' id='733' is-fixed='true' type-v2='empty' w='1667' x='24531' y='28149'>
              <zone-style>
                <format attr='border-color' value='#444444' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='18426' id='734' param='vert' type-v2='layout-flow' w='20885' x='26198' y='28149'>
              <zone forceUpdate='true' h='4908' id='735' type-v2='text' w='20885' x='26198' y='28149'>
                <formatted-text>
                  <run bold='true'>Topline Demand &amp; Freight Trajectory:  </run>
                  <run>Tracks YoY performance across Gross Revenue, GMV, Average Freight Value, and Freight-to-Price ratios to separate pure product demand from shipping cost inflation.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='67' forceUpdate='true' h='6945' id='736' is-fixed='true' type-v2='text' w='20885' x='26198' y='33057'>
                <formatted-text>
                  <run bold='true'>Payment &amp; Installment Mechanics: </run>
                  <run>Breaks down transaction volume across Credit Card, Boleto Bancário, Voucher, and Debit Card alongside Boleto settlement lag, instant cash ratios, and high-risk long-term installment exposure in 7-10+ installments</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='4908' id='737' type-v2='text' w='20885' x='26198' y='40002'>
                <formatted-text>
                  <run bold='true'>Leakage &amp; Promo Reconciliation:  </run>
                  <run>Quantifies unfulfilled revenue from order cancellations and expired Boleto slips, while recording voucher spend against net payment realization and freight drag.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone fixed-size='42' forceUpdate='true' h='4630' id='731' is-fixed='true' type-v2='text' w='22552' x='24531' y='46575'>
            <formatted-text>
              <run bold='true'>Primary Executive Decisions Supported:  </run>
              <run>Identifying where gross demand fails to convert into collected cash and optimizing payment incentives to reduce settlement delays.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='36389' id='718' param='vert' type-v2='layout-flow' w='24375' x='48021' y='16944'>
          <zone forceUpdate='true' h='2593' id='721' type-v2='text' w='24375' x='48021' y='16944'>
            <formatted-text>
              <run bold='true' fontsize='12'>OPERATIONAL METRICS AND DELIVERY PERFORMANCE</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='60' forceUpdate='true' h='6297' id='738' is-fixed='true' type-v2='text' w='24375' x='48021' y='19537'>
            <formatted-text>
              <run bold='true'>Strategic Objective: </run>
              <run>Diagnoses end-to-end fulfillment efficiency, pinpoints geographic shipping bottlenecks, and isolates root-cause accountability between sellers and logistics carriers.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='2130' id='739' type-v2='text' w='24375' x='48021' y='25834'>
            <formatted-text>
              <run bold='true'>Core Analytical Modules:</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone fixed-size='224' h='20741' id='741' is-fixed='true' param='horz' type-v2='layout-flow' w='24375' x='48021' y='27964'>
            <zone fixed-size='24' h='20741' id='742' is-fixed='true' type-v2='empty' w='1667' x='48021' y='27964'>
              <zone-style>
                <format attr='border-color' value='#444444' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='20741' id='743' param='vert' type-v2='layout-flow' w='22708' x='49688' y='27964'>
              <zone forceUpdate='true' h='4908' id='744' type-v2='text' w='22708' x='49688' y='27964'>
                <formatted-text>
                  <run bold='true'>Nationwide KPIs &amp; Geographic Bottlenecks:  </run>
                  <run>Benchmarks Late Delivery Rate, Fulfillment Lead Time, and On-Time In-Full (OTIF) rates against prior-year baselines, paired with a state heat map highlighting severe regional friction.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='68' forceUpdate='true' h='7037' id='745' is-fixed='true' type-v2='text' w='22708' x='49688' y='32872'>
                <formatted-text>
                  <run bold='true'>Root-Cause &amp; Category Friction:  P</run>
                  <run>artitions delayed orders between Seller Dispatch Delays and Carrier Transit Delays, while ranking the highest-delay product categories and worst-performing interstate shipping corridors by volume and late delivery rate.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='6297' id='746' type-v2='text' w='22708' x='49688' y='39909'>
                <formatted-text>
                  <run bold='true'>Hub &amp; Dispatch SLA Diagnostics:  </run>
                  <run>Evaluates seller dispatch speed against category late rates via quadrant scatter analysis and benchmarks individual seller origin hubs on delivered order volume, late delivery rate, and avg. transit variance in seller dispatch and carrier transit.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone h='4628' id='740' type-v2='text' w='24375' x='48021' y='48705'>
            <formatted-text>
              <run bold='true'>Primary Executive Decision Supported: </run>
              <run>Reallocating regional 3PL carrier capacity, adjusting checkout delivery estimates for high-risk corridors, and enforcing seller dispatch SLAs.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
        </zone>
        <zone h='34907' id='719' param='vert' type-v2='layout-flow' w='24375' x='73281' y='16944'>
          <zone forceUpdate='true' h='2593' id='722' type-v2='text' w='24375' x='73281' y='16944'>
            <formatted-text>
              <run bold='true' fontsize='12'>CUSTOMER SATISFACTION AND REVIEW PERFORMANCE</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
