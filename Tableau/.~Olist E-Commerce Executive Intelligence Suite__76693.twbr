    <worksheet name='Order Cancellation and Financial Leakage'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/OrderCancellationandLeakage?rev=' id='OrderCancellationandLeakage' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Cancelled GMV Leakage' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014424814227471]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;canceled&apos; THEN [price] END)' />
            </column>
            <column caption='Financial Leakage Rate' datatype='real' name='[Calculation_0014424814436368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0014424814227471] / SUM( IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] END)' />
            </column>
            <column caption='Monthly Cancelled Volume by Reason' datatype='string' name='[Calculation_0014424814555153]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_status] = &apos;canceled&apos; THEN&#10;&#9;IF [payment_type] = &apos;boleto&apos; THEN &apos;Unpaid Boleto Slip&apos;&#10;    ELSEIF [payment_type] = &apos;credit_card&apos; THEN &apos;Credit Card Decline / Timeout&apos;&#10;    ELSE &apos;Other Cancelled Methods&apos;&#10;    END&#10;  END' />
            </column>
            <column caption='Keep Active Comparison Years' datatype='boolean' name='[Calculation_0014559309459505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;OR&#10;YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)' />
            </column>
            <column-instance column='[order_purchase_timestamp]' derivation='Month' name='[mn:order_purchase_timestamp:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0014424814555153]' derivation='None' name='[none:Calculation_0014424814555153:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0014559309459505]' derivation='None' name='[none:Calculation_0014559309459505:nk]' pivot='key' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;boleto&quot;' value='Boleto Bancário' />
                <alias key='&quot;credit_card&quot;' value='Credit Card' />
                <alias key='&quot;debit_card&quot;' value='Debit Card' />
                <alias key='&quot;voucher&quot;' value='Voucher' />
              </aliases>
            </column>
            <column caption='Price' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0014424814227471]' derivation='User' name='[usr:Calculation_0014424814227471:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0014424814436368]' derivation='User' name='[usr:Calculation_0014424814436368:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ahelyx13kq92b10yuz131bg1ek3].[none:Calculation_0014424814555153:nk]' kind='hide'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-manual-selection='true' user:ui-manual-selection-all-when-empty='true' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_0014424814555153:nk]' />
              <groupfilter function='member' level='[none:Calculation_0014424814555153:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0ahelyx13kq92b10yuz131bg1ek3].[none:Calculation_0014424814555153:nk]' direction='ASC'>
