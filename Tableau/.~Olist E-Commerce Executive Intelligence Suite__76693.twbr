        <calculation class='tableau' formula='[Calculation_0014559324966983]/[Calculation_0014559318024247]' />
      </column>
      <column caption='YoY FPR % Change' datatype='real' name='[Calculation_0014559354376277]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;NULL&#10;ELSE&#10;&#9;([Calculation_0014559353548883] - [Calculation_0014559354228820]) / [Calculation_0014559354228820]&#10;  END' />
      </column>
      <column caption='Current Year Cancelled GMV' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014562451226760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;canceled&apos; THEN [price] END)' />
      </column>
      <column caption='Previous Year Cancelled GMV' datatype='real' name='[Calculation_0014562451587210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;canceled&apos; THEN [price] END)' />
      </column>
      <column caption='YoY Cancelled GMV % Change' datatype='real' name='[Calculation_0014562451738765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;&#9;NULL&#10;ELSE&#10;  ([Calculation_0014562451226760] - [Calculation_0014562451587210]) / [Calculation_0014562451587210]&#10;END' />
      </column>
      <column caption='Current Year Leakage Rate' datatype='real' name='[Calculation_0014562453020817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0014562451226760]&#10;/&#10;[Calculation_0014559317827638]' />
      </column>
      <column caption='Previous Year Leakage Rate' datatype='real' name='[Calculation_0014562453348498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0014562451587210]&#10;/&#10;[Calculation_0014559318024247]' />
      </column>
      <column caption='YoY Leakage Rate Change' datatype='real' name='[Calculation_0014562453618835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;&#9;NULL&#10;ELSE&#10;&#9;[Calculation_0014562453020817] - [Calculation_0014562453348498]&#10;END' />
      </column>
      <column caption='Gross Merchandise Value' datatype='real' name='[Calculation_0014562505879571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [order_status] = &apos;delivered&apos; THEN [price] END)' />
      </column>
      <column caption='Current Year Avg Freight Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014562508836887]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [freight_value] END)' />
      </column>
      <column caption='Previous Year Avg Freight Value' datatype='real' name='[Calculation_0014562508951576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) THEN [freight_value] END)' />
      </column>
      <column caption='Current Year Voucher Spend' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014562526679081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [payment_type] = &apos;voucher&apos;&#10;AND [order_status] = &apos;delivered&apos;&#10;  THEN [payment_value] END)' />
      </column>
      <column caption='Previous Year Voucher Spend' datatype='real' name='[Calculation_0014562527174698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)&#10;AND [payment_type] = &apos;voucher&apos;&#10;AND [order_status] = &apos;delivered&apos;&#10;THEN [payment_value] END)' />
      </column>
      <column caption='YoY Voucher Spend Change' datatype='real' name='[Calculation_0014562527903788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;&#9;THEN NULL&#10;ELSE ([Calculation_0014562526679081]-[Calculation_0014562527174698]) / [Calculation_0014562527174698]&#10;END' />
      </column>
      <column caption='Current Year Voucher Discount Rate' datatype='real' name='[Calculation_0014562528309293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0014562526679081]&#10;/&#10;[Calculation_0014559317827638]' />
      </column>
      <column caption='Current Year Payment Realization Rate' datatype='real' name='[Calculation_0014562528673839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos; THEN {FIXED [order_id]: SUM([payment_value])} END)&#10;/&#10;SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status]= &apos;delivered&apos; THEN [price] + [freight_value] END)' />
      </column>
      <column caption='Row Count' datatype='integer' name='[Calculation_0014562533842993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([order_id])' />
      </column>
      <column caption='True Order Payment Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014562534682674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [order_id]: SUM([payment_value])}' />
      </column>
      <column caption='Previous Year Voucher Discount Rate' datatype='real' name='[Calculation_0014562541400115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0014562527174698]&#10;/&#10;[Calculation_0014559318024247]' />
      </column>
      <column caption='YoY Voucher Discount Rate' datatype='real' name='[Calculation_0014562541535284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE&#10;([Calculation_0014562528309293] - [Calculation_0014562541400115]) / [Calculation_0014562541400115]&#10;END' />
      </column>
      <column caption='CY Gross GMV' datatype='real' name='[Calculation_0014562550136891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos;&#10;THEN [price] END)' />
      </column>
      <column caption='CY Voucher Spend' datatype='real' name='[Calculation_0014562550386748]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;       AND [payment_type] = &apos;voucher&apos; &#10;       AND [order_status] = &apos;delivered&apos; &#10;    THEN [payment_value] END)' />
      </column>
      <column caption='CY Freight' datatype='real' name='[Calculation_0014562550485053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;       AND [order_status] = &apos;delivered&apos; &#10;    THEN [freight_value] END)' />
      </column>
      <column caption='CY Net Cash Realized' datatype='real' name='[Calculation_0014562550583358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;       AND [order_status] = &apos;delivered&apos; &#10;    THEN {FIXED [order_id]: SUM([payment_value])} END)' />
      </column>
      <column caption='Category Late Delivery Rate' datatype='real' name='[Calculation_0014563577827407]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Category Avg Transit Delay Days' datatype='real' name='[Calculation_0014563578298448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    THEN DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])&#10;    END&#10;    )' />
      </column>
      <column caption='Rank Filter' datatype='boolean' name='[Calculation_0014563583238225]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK([Calculation_0014563577827407]) &lt;= 5'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous Year Payment Realization Rate' datatype='real' name='[Calculation_0014563591549012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;delivered&apos; THEN {FIXED [order_id]: SUM([payment_value])} END)&#10;/&#10;SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status]= &apos;delivered&apos; THEN [price] + [freight_value] END)' />
      </column>
      <column caption='YoY Payment Realization Rate Change' datatype='real' name='[Calculation_0014563591725141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE [Calculation_0014562528673839] - [Calculation_0014563591549012]&#10;END' />
      </column>
      <column caption='Current Year Delayed Orders Count' datatype='integer' name='[Calculation_0014567520432134]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_purchase_timestamp])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND NOT ISNULL([order_delivered_carrier_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Shipping Rank Filter' datatype='integer' name='[Calculation_0014567538110474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Current Year Delayed Orders no carrier null' datatype='integer' name='[Calculation_0014567541137419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_purchase_timestamp])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='State Title Display' datatype='string' name='[Calculation_0014700932206595]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([customer_state]) = MAX([customer_state])&#10;THEN MIN([customer_state])&#10;ELSE &quot;All States (Brazil)&quot;&#10;END' />
      </column>
      <column caption='Filter - First Row' datatype='boolean' name='[Calculation_0014700933476356]' role='measure' type='nominal'>
        <calculation class='tableau' formula='FIRST() == 0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dummy' datatype='string' name='[Calculation_0014700942684168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Dummy&quot;' />
      </column>
      <column caption='Hub Late Delivery Rate' datatype='real' name='[Calculation_0014700965056542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_delivered_carrier_date])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;      THEN [order_id]&#10;      END&#10;    )&#10;/ [Calculation_0014700967469088]' />
      </column>
      <column caption='Hub Delivered Orders' datatype='integer' name='[Calculation_0014700967469088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_carrier_date])&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;  THEN [order_id]&#10;END&#10;)' />
      </column>
      <column caption='Avg Carrier Transit Days' datatype='real' name='[Calculation_0014700967776289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    THEN DATEDIFF(&apos;day&apos;, [order_delivered_carrier_date], [order_delivered_customer_date])&#10;    END&#10;    )' />
      </column>
      <column caption='Avg Days Late / Early vs. SLA' datatype='real' name='[Calculation_0014700968230946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    THEN DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])&#10;    END&#10;)' />
      </column>
      <column caption='Net Cash Realization Rate' datatype='real' default-format='p0.00%' name='[Calculation_0014768767574037]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([price]) - SUM(IF [payment_type] = &apos;voucher&apos; THEN [payment_value] ELSE 0 END)) &#10;/ &#10;SUM([price] + [freight_value])' />
      </column>
      <column caption='Freight Drag %' datatype='real' name='[Calculation_0014768777334806]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [freight_value] END) &#10;/ &#10;SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] + [freight_value] END)' />
      </column>
      <column caption='Voucher Drag %' datatype='real' name='[Calculation_0014768777453591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0014768777732120]) / &#10;SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] + [freight_value] END)' />
      </column>
      <column caption='voucher value' datatype='real' name='[Calculation_0014768777732120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [payment_type] = &apos;voucher&apos; THEN [payment_value] ELSE 0 END' />
      </column>
      <column caption='Orders per Customer' datatype='integer' name='[Calculation_0014833052143619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id]:COUNTD([order_id])}' />
      </column>
      <column caption='Customer Segment' datatype='string' name='[Calculation_0014833052340228]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0014833052143619] = 1 THEN &quot;One-Time Customer&quot;&#10;ELSE &quot;Repeat Customer (2+Orders)&quot;&#10;END' />
      </column>
      <column caption='Avg Order Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014833113632834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price]) / COUNTD([order_id])' />
      </column>
      <column caption='Freight Ratio %' datatype='real' name='[Calculation_0014833115504707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([freight_value]) / SUM([price])' />
      </column>
      <column caption='Installment Bracket' datatype='string' name='[Calculation_0014833250615359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [payment_installments] = 1 THEN &quot;1x (Immediate)&quot;&#10;ELSEIF [payment_installments] &gt;= 2 AND [payment_installments] &lt;= 3 THEN &quot;2-3x (Short Term)&quot;&#10;ELSEIF [payment_installments] &gt;= 4 AND [payment_installments] &lt;= 6 THEN &quot;4-6x (Medium Term)&quot;&#10;ELSEIF [payment_installments] &gt;= 7 THEN &quot;7-10+x (Long Term)&quot;&#10;END' />
      </column>
      <column caption='Zero Axis' datatype='integer' name='[Calculation_0014838059335681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Payment Volume Share' datatype='real' default-format='p0.0%' name='[Calculation_0014903031685125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [payment_value] END&#10;) &#10;/&#10;TOTAL(&#10;SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [payment_value] END)&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Installment Volume %' datatype='real' name='[Calculation_0014905811804166]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [payment_type] = &apos;credit_card&apos; &#10;THEN [payment_value] END)&#10;/ &#10;TOTAL(SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [payment_type] = &apos;credit_card&apos; THEN [payment_value] END))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Installment Risk Color' datatype='string' name='[Calculation_0014905812258823]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0014833250615359] = &apos;7-10+x (Long Term)&apos; THEN &apos;High Cash Deferral&apos;&#10;ELSE &apos;Standard&apos;&#10;END' />
      </column>
      <column caption='Avg Installments' datatype='real' name='[Calculation_0014905815134216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [payment_type] = &apos;credit_card&apos; AND YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [payment_installments] END)' />
      </column>
      <column caption='High Risk Exposure Share' datatype='real' default-format='p0.00%' name='[Calculation_0014975456075945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;{FIXED [order_id]:&#10;MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [payment_type] = &apos;credit_card&apos; &#10;AND [payment_installments] &gt;= 7 &#10;AND [order_status] = &apos;delivered&apos; &#10;THEN {FIXED [order_id]: SUM([price])} &#10;ELSE 0 &#10;END&#10;)}) &#10;/ &#10;SUM(&#10;{FIXED [order_id] :&#10;MAX(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos; &#10;THEN {FIXED [order_id]: SUM([price])} END&#10;)})' />
      </column>
      <column caption='Actual Transit Days' datatype='integer' name='[Calculation_0014975466225838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_delivered_carrier_date], [order_delivered_customer_date])' />
      </column>
      <column caption='Promised Delivery Buffer (Days)' datatype='integer' name='[Calculation_0014975466455216]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_delivered_customer_date], [order_estimated_delivery_date])' />
      </column>
      <column caption='Late Delivery Rate' datatype='real' default-format='p0.00%' name='[Calculation_0014975466660017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN 1 ELSE 0 END)&#10;/&#10;COUNTD([order_id])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_0014975477141689]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='&quot;Brazil&quot;' />
      </column>
      <column caption='Seller Dispatch Lag (Days)' datatype='integer' name='[Calculation_0014975492849863]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_carrier_date])' />
      </column>
      <column caption='Carrier Transit Lag (Days)' datatype='integer' name='[Calculation_0014975493075144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF( &apos;day&apos;, [order_delivered_carrier_date], [order_delivered_customer_date])' />
      </column>
      <column caption='Delay Root Cause' datatype='string' name='[Calculation_0014975493361865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN &#10;&#9;IF [order_delivered_carrier_date] &gt; [order_estimated_delivery_date] THEN&#10;    &#9;&quot;Seller Dispatch Delay&quot;&#10;    ELSE&#10;        &quot;Carrier Transit Delay&quot;&#10;    END&#10;ELSE&#10;&#9;&quot;On-Time&quot;&#10;END' />
      </column>
      <column caption='Current Year Late Delivery Rate' datatype='real' name='[Calculation_0015456558383109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;&#9;AND NOT ISNULL([order_delivered_customer_date])&#10;&#9;AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;  THEN [order_id] END)&#10;/&#10;COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;&#9;AND NOT ISNULL([order_delivered_customer_date])&#10;  THEN [order_id] END)' />
      </column>
      <column caption='Previous Year Late Delivery Rate' datatype='real' name='[Calculation_0015456558829574]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_delivered_customer_date])&#10;AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id] END)&#10;/&#10;COUNTD(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_delivered_customer_date])&#10;&#9;THEN [order_id] END)' />
      </column>
      <column caption='YoY Late Delivery Rate Change' datatype='real' name='[Calculation_0015456558952455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE ([Calculation_0015456558383109] - [Calculation_0015456558829574]) / [Calculation_0015456558829574]&#10;END' />
      </column>
      <column caption='Current Year Avg Fulfillment Lead Time' datatype='real' name='[Calculation_0015456559624200]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;{FIXED [order_id]:&#10;MIN(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_purchase_timestamp])&#10;AND NOT ISNULL([order_approved_at])&#10;AND NOT ISNULL([order_delivered_carrier_date])&#10;&#9;THEN DATEDIFF(&apos;second&apos;, [order_approved_at], [order_delivered_carrier_date]) / 86400.0&#10;END&#10;)&#10;}&#10;)' />
      </column>
      <column caption='Previous Year Avg Fulfillment Lead Time' datatype='real' name='[Calculation_0015456559919114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;{FIXED [order_id] :&#10;MIN(&#10;IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_purchase_timestamp])&#10;AND NOT ISNULL([order_approved_at])&#10;AND NOT ISNULL([order_delivered_carrier_date])&#10;&#9;THEN DATEDIFF(&apos;second&apos;, [order_purchase_timestamp], [order_delivered_customer_date]) / 86400.0 &#10;END&#10;)&#10;}&#10;)' />
      </column>
      <column caption='YoY Fulfillment Lead Time Change' datatype='real' name='[Calculation_0015456560111627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE([Calculation_0015456559624200] - [Calculation_0015456559919114]) / [Calculation_0015456559919114] END' />
      </column>
      <column caption='Current Year OTIF Rate' datatype='real' name='[Calculation_0015456560812044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_delivered_customer_date] &lt;= [order_estimated_delivery_date]&#10;    AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;    THEN [order_id] END)&#10;/&#10;COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;&#9;THEN [order_id] END)' />
