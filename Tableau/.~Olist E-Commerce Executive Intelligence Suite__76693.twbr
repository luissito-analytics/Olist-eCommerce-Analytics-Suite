                <alias key='&quot;credit_card&quot;' value='Credit Card' />
                <alias key='&quot;debit_card&quot;' value='Debit Card' />
                <alias key='&quot;voucher&quot;' value='Voucher' />
              </aliases>
            </column>
            <column caption='Payment Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[payment_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0014355632906325]' derivation='User' name='[usr:Calculation_0014355632906325:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0014355633143895]' derivation='User' name='[usr:Calculation_0014355633143895:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
