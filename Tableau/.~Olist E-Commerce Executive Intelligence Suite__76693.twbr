    <worksheet name='Delay Root Cause Breakdown'>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/DelayRootCauseBreakdown?rev=' id='DelayRootCauseBreakdown' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Keep Active Comparison Years' datatype='boolean' name='[Calculation_0014559309459505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;OR&#10;YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)' />
            </column>
            <column caption='Current Year Delayed Orders Count' datatype='integer' name='[Calculation_0014567520432134]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_purchase_timestamp])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND NOT ISNULL([order_delivered_carrier_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id]&#10;    END&#10;)' />
            </column>
            <column caption='Dummy' datatype='string' name='[Calculation_0014700942684168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Dummy&quot;' />
            </column>
            <column caption='Zero Axis' datatype='integer' name='[Calculation_0014838059335681]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_0014975477141689]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='&quot;Brazil&quot;' />
            </column>
            <column caption='Delay Root Cause' datatype='string' name='[Calculation_0014975493361865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN &#10;&#9;IF [order_delivered_carrier_date] &gt; [order_estimated_delivery_date] THEN&#10;    &#9;&quot;Seller Dispatch Delay&quot;&#10;    ELSE&#10;        &quot;Carrier Transit Delay&quot;&#10;    END&#10;ELSE&#10;&#9;&quot;On-Time&quot;&#10;END' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0014559309459505]' derivation='None' name='[none:Calculation_0014559309459505:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0014700942684168]' derivation='None' name='[none:Calculation_0014700942684168:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0014838059335681]' derivation='None' name='[none:Calculation_0014838059335681:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0014975493361865]' derivation='None' name='[none:Calculation_0014975493361865:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Carrier Date' datatype='datetime' name='[order_delivered_carrier_date]' role='dimension' type='ordinal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0014567520432134]' derivation='User' name='[pcto:usr:Calculation_0014567520432134:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
