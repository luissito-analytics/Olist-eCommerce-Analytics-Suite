    <worksheet name='Top Delayed Shipping Routes'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555'>Top Delayed Shipping Routes by Volume</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Shipping Rank Filter' datatype='integer' name='[Calculation_0014567538110474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Current Year Delayed Orders no carrier null' datatype='integer' name='[Calculation_0014567541137419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND [order_status] = &apos;delivered&apos;&#10;        AND NOT ISNULL([order_purchase_timestamp])&#10;        AND NOT ISNULL([order_delivered_customer_date])&#10;        AND NOT ISNULL([order_estimated_delivery_date])&#10;        AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id]&#10;    END&#10;)' />
            </column>
            <column caption='Dummy' datatype='string' name='[Calculation_0014700942684168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='&quot;Dummy&quot;' />
            </column>
            <column caption='Country' datatype='string' name='[Calculation_0014975477141689]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='&quot;Brazil&quot;' />
            </column>
            <column caption='Shipping Corridor' datatype='string' name='[Calculation_0589196809330688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[seller_state] + &quot; ➔ &quot; + [customer_state]' />
            </column>
            <column caption='Route Avg Delay Days' datatype='real' name='[Calculation_0589196809531393]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;    {FIXED [order_id], [Calculation_0589196809330688] : &#10;        MIN(&#10;            IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;               AND [order_status] = &apos;delivered&apos;&#10;               AND NOT ISNULL([order_delivered_customer_date])&#10;               AND NOT ISNULL([order_estimated_delivery_date])&#10;               AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;            THEN DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date])&#10;            END&#10;        )&#10;    }&#10;)' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_0589196809330688]' derivation='None' name='[none:Calculation_0589196809330688:nk]' pivot='key' type='nominal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Seller State' datatype='string' name='[seller_state]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
