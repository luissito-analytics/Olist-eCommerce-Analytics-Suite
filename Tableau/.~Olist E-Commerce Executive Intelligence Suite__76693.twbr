            <column caption='Current Year Review Score' datatype='real' name='[Calculation_2165346862112770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;If YEAR( [order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND NOT ISNULL([order_purchase_timestamp])&#10;    AND NOT ISNULL([review_score])&#10;THEN [review_score] END)' />
