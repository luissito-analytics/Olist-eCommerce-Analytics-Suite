      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Current Year Boleto Leakage Share' datatype='real' name='[Calculation_0014425015566493]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;canceled&apos; AND [payment_type] = &apos;boleto&apos; THEN [price] END)&#10;/&#10;[Calculation_0014562451226760]' />
            </column>
            <column caption='Previous Year Boleto Leakage Share' datatype='real' name='[Calculation_0014425015931038]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;canceled&apos; AND [payment_type] = &apos;boleto&apos; THEN [price] END)&#10;/&#10;[Calculation_0014562451587210]' />
            </column>
            <column caption='YoY Boleto Leakage Share Change' datatype='real' name='[Calculation_0014425016090783]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;NULL&#10;ELSE&#10;([Calculation_0014425015566493] - [Calculation_0014425015931038]) / [Calculation_0014425015931038]&#10;END' />
            </column>
            <column caption='Current Year Cancelled GMV' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014562451226760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;canceled&apos; THEN [price] END)' />
            </column>
            <column caption='Previous Year Cancelled GMV' datatype='real' name='[Calculation_0014562451587210]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;canceled&apos; THEN [price] END)' />
            </column>
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column caption='Payment Type' datatype='string' name='[payment_type]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;boleto&quot;' value='Boleto Bancário' />
                <alias key='&quot;credit_card&quot;' value='Credit Card' />
                <alias key='&quot;debit_card&quot;' value='Debit Card' />
                <alias key='&quot;voucher&quot;' value='Voucher' />
              </aliases>
            </column>
            <column caption='Price' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0014425015566493]' derivation='User' name='[usr:Calculation_0014425015566493:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0014425016090783]' derivation='User' name='[usr:Calculation_0014425016090783:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
