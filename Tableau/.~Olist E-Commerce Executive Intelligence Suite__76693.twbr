    <worksheet name='BAN - Avg Fulfillment Lead Time'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' italic='true'>Avg. Fulfillment Lead Time</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/BAN-AvgFulfillmentLeadTime?rev=' id='BAN-AvgFulfillmentLeadTime' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Current Year Avg Fulfillment Lead Time' datatype='real' name='[Calculation_0015456559624200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;{FIXED [order_id]:&#10;MIN(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_purchase_timestamp])&#10;AND NOT ISNULL([order_approved_at])&#10;AND NOT ISNULL([order_delivered_carrier_date])&#10;&#9;THEN DATEDIFF(&apos;second&apos;, [order_approved_at], [order_delivered_carrier_date]) / 86400.0&#10;END&#10;)&#10;}&#10;)' />
            </column>
            <column caption='PY Avg Fulfillment Lead Time' datatype='real' name='[Calculation_2775235019243520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#10;{FIXED [order_id]:&#10;MIN(&#10;IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_purchase_timestamp])&#10;AND NOT ISNULL([order_approved_at])&#10;AND NOT ISNULL([order_delivered_carrier_date])&#10;THEN DATEDIFF(&apos;second&apos;, [order_approved_at], [order_delivered_carrier_date]) / 86400.0&#10;END&#10;)&#10;}&#10;)' />
            </column>
            <column caption='Year on Year Avg Fulfillment Lead Time Change' datatype='real' name='[Calculation_2775235019804673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE ([Calculation_0015456559624200] - [Calculation_2775235019243520]) / [Calculation_2775235019243520]&#10;END' />
            </column>
            <column caption='Order Approved At' datatype='datetime' name='[order_approved_at]' role='dimension' type='ordinal' />
            <column caption='Order Delivered Carrier Date' datatype='datetime' name='[order_delivered_carrier_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0015456559624200]' derivation='User' name='[usr:Calculation_0015456559624200:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2775235019804673]' derivation='User' name='[usr:Calculation_2775235019804673:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
