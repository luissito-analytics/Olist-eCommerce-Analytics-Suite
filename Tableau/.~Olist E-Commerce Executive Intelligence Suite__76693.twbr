    <worksheet name='Review vs Delivery Delay Matrix'>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='RFM Anchor Date' datatype='datetime' name='[Calculation_0013880608641163]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED : MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_purchase_timestamp] END)}' />
            </column>
            <column caption='Recency Days' datatype='integer' name='[Calculation_1896722372538368]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [customer_unique_id] : MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_purchase_timestamp] END)},&#10;[Calculation_0013880608641163])' />
            </column>
            <column caption='Order Frequency' datatype='integer' name='[Calculation_1896722373836801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_unique_id] : COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_id (fact_orderitems.csv)] END)}' />
            </column>
            <column caption='Lifetime Spend' datatype='real' name='[Calculation_1896722374057986]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [customer_unique_id] : SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] + [freight_value] END)}' />
            </column>
            <column caption='RFM Customer Segment' datatype='string' name='[Calculation_1896722374512643]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1896722373836801] &gt;= 2 AND [Calculation_1896722374057986] &gt;= 300 THEN&#10;&apos;Champions &amp; VIPs&apos;&#10;ELSEIF [Calculation_1896722373836801] &gt;= 2 THEN&#10;&apos;Loyal Repeat Customers&apos;&#10;ELSEIF [Calculation_1896722372538368] &lt;= 180 AND [Calculation_1896722374057986] &gt;= 300 THEN&#10;&apos;High-Value Single Buyers&apos;&#10;ELSEIF [Calculation_1896722372538368] &lt;= 180 THEN&#10;&apos;Recent Standard Buyers&apos;&#10;ELSE&#10;&apos;Lapsed / At-Risk Buyers&apos;&#10;END' />
            </column>
            <column caption='Delivery Delay Bucket' datatype='string' name='[Calculation_2933012402483209]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([order_delivered_customer_date]) THEN &quot;Not Delivered&quot;&#10;ELSEIF [order_delivered_customer_date] &lt;= [order_estimated_delivery_date] THEN &quot;On Time/Early&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date]) &lt;= 3 THEN &quot;1-3 Days Late&quot;&#10;ELSEIF DATEDIFF(&apos;day&apos;, [order_estimated_delivery_date], [order_delivered_customer_date]) &lt;= 7 THEN &quot;4-7 Days Late&quot;&#10;ELSE &quot;8+ Days Late&quot;&#10;END' />
            </column>
            <column caption='Current Year Total Orders Distinct' datatype='integer' name='[Calculation_2933012404740106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;THEN [order_id] END)' />
            </column>
            <column caption='Customer Unique Id' datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' />
            <column caption='Freight Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[freight_value]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2933012402483209]' derivation='None' name='[none:Calculation_2933012402483209:nk]' pivot='key' type='nominal' />
            <column-instance column='[review_score]' derivation='None' name='[none:review_score:ok]' pivot='key' type='ordinal' />
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Id (Fact Orderitems.Csv)' datatype='string' name='[order_id (fact_orderitems.csv)]' role='dimension' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2933012404740106]' derivation='User' name='[pcto:usr:Calculation_2933012404740106:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' type='PctTotal' />
            </column-instance>
            <column caption='Price' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[price]' role='measure' type='quantitative' />
            <column aggregation='Sum' caption='Review Score' datatype='integer' name='[review_score]' role='dimension' type='ordinal'>
              <aliases>
                <alias key='1' value='1★' />
                <alias key='2' value='2★' />
                <alias key='3' value='3★' />
                <alias key='4' value='4★' />
                <alias key='5' value='5★' />
              </aliases>
            </column>
            <column-instance column='[Calculation_2933012404740106]' derivation='User' name='[usr:Calculation_2933012404740106:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0ahelyx13kq92b10yuz131bg1ek3].[Action (RFM Customer Segment)]'>
            <groupfilter function='level-members' level='[Calculation_1896722374512643]' user:ui-action-filter='[Action9_1542D26750F741C6B975561A78C54EA1]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.0ahelyx13kq92b10yuz131bg1ek3].[none:Calculation_2933012402483209:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;On Time/Early&quot;</bucket>
              <bucket>&quot;1-3 Days Late&quot;</bucket>
              <bucket>&quot;4-7 Days Late&quot;</bucket>
              <bucket>&quot;8+ Days Late&quot;</bucket>
              <bucket>&quot;Not Delivered&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.0ahelyx13kq92b10yuz131bg1ek3].[none:review_score:ok]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:review_score:ok]' />
              <groupfilter function='member' level='[none:review_score:ok]' member='%null%' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0ahelyx13kq92b10yuz131bg1ek3].[none:review_score:ok]' direction='ASC'>
            <dictionary>
              <bucket>1</bucket>
              <bucket>2</bucket>
              <bucket>3</bucket>
              <bucket>4</bucket>
              <bucket>5</bucket>
              <bucket>%null%</bucket>
            </dictionary>
          </manual-sort>
          <slices>
            <column>[federated.0ahelyx13kq92b10yuz131bg1ek3].[none:review_score:ok]</column>
            <column>[federated.0ahelyx13kq92b10yuz131bg1ek3].[Action (RFM Customer Segment)]</column>
          </slices>
          <aggregation value='true' />
        </view>
