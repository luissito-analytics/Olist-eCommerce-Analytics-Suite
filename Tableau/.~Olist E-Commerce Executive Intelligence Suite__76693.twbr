            <column caption='Current Year Freight Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014559324897350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [freight_value] END)' />
