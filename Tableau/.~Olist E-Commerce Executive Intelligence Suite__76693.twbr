          <map key='[shipping_limit_date]' value='[fact_orderitems.csv].[shipping_limit_date]' />
        </cols>
      </connection>
      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[ctd:order_id:qk]&quot;' value='Total Orders' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0001167584497726:qk]&quot;' value='Orders' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0013880562135113:qk]&quot;' value='Avg. Seller Dispatch Days' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0013880562516045:qk]&quot;' value='Avg. Carrier Transit Days' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0014700965056542:qk]&quot;' value='Late Delivery %' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0014700967469088:qk]&quot;' value='Delivered Orders' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0014700967776289:qk]&quot;' value='Avg. Transit Days' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_0014700968230946:qk]&quot;' value='Avg. Days Late/Early' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_2268700976738305:qk]&quot;' value='Average Order Value' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_2268700976943106:qk]&quot;' value='Average CSAT' />
          <alias key='&quot;[federated.0ahelyx13kq92b10yuz131bg1ek3].[usr:Calculation_2268700979789829:qk]&quot;' value='Total Orders ' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id]) / TOTAL(COUNTD([order_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id]) / TOTAL(COUNTD([order_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_unique_id]) / TOTAL(COUNTD([customer_unique_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2933012404740106] / TOTAL([Calculation_2933012404740106])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_2933012404740106] / TOTAL([Calculation_2933012404740106])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Max State Late Delivery Rate' datatype='real' name='[Calculation_0001162926104576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_0015456558383109])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Worst State Name' datatype='string' name='[Calculation_0001162926272513]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0001162931900423] = [Calculation_0001162932797448] THEN [customer_state] END' />
      </column>
      <column caption='State Late Delivery Rate' datatype='real' name='[Calculation_0001162931900423]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_state] : [Calculation_0015456558383109] }' />
      </column>
      <column caption='Max Late Delivery Rate' datatype='real' name='[Calculation_0001162932797448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ MAX([Calculation_0001162931900423]) }' />
      </column>
      <column caption='Current Year Review Score on Delivered Only' datatype='real' name='[Calculation_0001167574773820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;       AND [order_status] = &apos;delivered&apos;&#10;    THEN [review_score]&#10;    END&#10;)' />
      </column>
      <column caption='Current Year State Orders' datatype='integer' name='[Calculation_0001167580348477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    AND [order_status] = &apos;delivered&apos;&#10;  THEN [order_id]&#10;  END)' />
      </column>
      <column caption='Current Year Total Orders Payment Type' datatype='integer' name='[Calculation_0001167584497726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    AND [order_status] = &apos;delivered&apos;&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='gross revenue for chart' datatype='real' name='[Calculation_0001167595798591]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &apos;delivered&apos; THEN [price]+[freight_value] END)' />
      </column>
      <column caption='Category Delivered Orders' datatype='integer' name='[Calculation_0013880548307012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    AND [order_status] = &apos;delivered&apos;&#10;    AND NOT ISNULL([order_delivered_customer_date])&#10;    AND NOT ISNULL([order_estimated_delivery_date])&#10;    THEN [order_id]&#10;    END&#10;)' />
      </column>
      <column caption='Hub Avg Seller Dispatch Days' datatype='real' name='[Calculation_0013880562135113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    {FIXED [order_id], [seller_state] : &#10;        MIN(&#10;            IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;               AND [order_status] = &apos;delivered&apos;&#10;               AND NOT ISNULL([order_delivered_carrier_date])&#10;               AND NOT ISNULL([order_delivered_customer_date])&#10;               AND NOT ISNULL([order_estimated_delivery_date])&#10;            THEN DATEDIFF(&apos;day&apos;, [order_purchase_timestamp], [order_delivered_carrier_date])&#10;            END&#10;        )&#10;    }&#10;)' />
      </column>
      <column caption='Hub Avg Carrier Transit Days' datatype='real' name='[Calculation_0013880562516045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#10;    {FIXED [order_id], [seller_state] : &#10;        MIN(&#10;            IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;               AND [order_status] = &apos;delivered&apos;&#10;               AND NOT ISNULL([order_delivered_carrier_date])&#10;               AND NOT ISNULL([order_delivered_customer_date])&#10;               AND NOT ISNULL([order_estimated_delivery_date])&#10;            THEN DATEDIFF(&apos;day&apos;, [order_delivered_carrier_date], [order_delivered_customer_date])&#10;            END&#10;        )&#10;    }&#10;)' />
      </column>
      <column caption='RFM Anchor Date' datatype='datetime' name='[Calculation_0013880608641163]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED : MAX(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_purchase_timestamp] END)}' />
      </column>
      <column caption='RFM Customer Count' datatype='integer' name='[Calculation_0013880610676877]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;&#9;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;    &#9;AND NOT ISNULL([order_id (fact_orderitems.csv)])&#10;    THEN [customer_unique_id]&#10;    END)' />
      </column>
      <column caption='Is Delayed' datatype='string' name='[Calculation_0014214330974266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN &quot;Delayed&quot;&#10;ELSE &quot;On-Time / Early&quot;&#10;END' />
      </column>
      <column caption='Delay Rate %' datatype='real' name='[Calculation_0014214331494460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_delivered_customer_date] &gt; [order_estimated_delivery_date] THEN 1 ELSE 0 END) / COUNT([order_id])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0014214331863102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos; &#10;  THEN [price] + [freight_value] END)' />
      </column>
      <column caption='Hex Column (X)' datatype='integer' name='[Calculation_0014215014625310]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [customer_state]&#10;  WHEN &apos;AC&apos; THEN 1  WHEN &apos;AM&apos; THEN 2  WHEN &apos;RR&apos; THEN 3  WHEN &apos;AP&apos; THEN 4&#10;  WHEN &apos;RO&apos; THEN 2  WHEN &apos;PA&apos; THEN 3  WHEN &apos;MA&apos; THEN 4  WHEN &apos;CE&apos; THEN 5&#10;  WHEN &apos;MT&apos; THEN 3  WHEN &apos;TO&apos; THEN 4  WHEN &apos;PI&apos; THEN 5  WHEN &apos;RN&apos; THEN 6&#10;  WHEN &apos;MS&apos; THEN 3  WHEN &apos;GO&apos; THEN 4  WHEN &apos;BA&apos; THEN 5  WHEN &apos;PB&apos; THEN 6&#10;  WHEN &apos;PR&apos; THEN 3  WHEN &apos;DF&apos; THEN 4  WHEN &apos;MG&apos; THEN 5  WHEN &apos;PE&apos; THEN 6&#10;  WHEN &apos;SC&apos; THEN 3  WHEN &apos;ES&apos; THEN 4  WHEN &apos;RJ&apos; THEN 5  WHEN &apos;AL&apos; THEN 6&#10;  WHEN &apos;RS&apos; THEN 3  WHEN &apos;SP&apos; THEN 4  WHEN &apos;SE&apos; THEN 6&#10;END' />
      </column>
      <column caption='Hex Row (Y)' datatype='integer' name='[Calculation_0014215014862879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [customer_state]&#10;  WHEN &apos;RR&apos; THEN 6  WHEN &apos;AP&apos; THEN 6&#10;  WHEN &apos;AM&apos; THEN 5  WHEN &apos;PA&apos; THEN 5  WHEN &apos;MA&apos; THEN 5  WHEN &apos;CE&apos; THEN 5  WHEN &apos;RN&apos; THEN 5  WHEN &apos;PB&apos; THEN 5&#10;  WHEN &apos;AC&apos; THEN 4  WHEN &apos;RO&apos; THEN 4  WHEN &apos;TO&apos; THEN 4  WHEN &apos;PI&apos; THEN 4  WHEN &apos;PE&apos; THEN 4  WHEN &apos;AL&apos; THEN 4&#10;  WHEN &apos;MT&apos; THEN 3  WHEN &apos;GO&apos; THEN 3  WHEN &apos;DF&apos; THEN 3  WHEN &apos;BA&apos; THEN 3  WHEN &apos;SE&apos; THEN 3&#10;  WHEN &apos;MS&apos; THEN 2  WHEN &apos;MG&apos; THEN 2  WHEN &apos;ES&apos; THEN 2&#10;  WHEN &apos;PR&apos; THEN 1  WHEN &apos;SP&apos; THEN 1  WHEN &apos;RJ&apos; THEN 1&#10;  WHEN &apos;SC&apos; THEN 0  WHEN &apos;RS&apos; THEN -1&#10;END' />
      </column>
      <column caption='Payment Cash Speed' datatype='string' name='[Calculation_0014285862064231]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [payment_type] IN (&apos;debit_card&apos;, &apos;voucher&apos;) THEN &apos;Instant Settlement&apos;&#10;ELSEIF [payment_type] = &apos;boleto&apos; THEN &apos;1-3 Day Clearing Lag&apos;&#10;ELSEIF [payment_type] = &apos;credit_card&apos; THEN &apos;Installment / Deferred Flow&apos;&#10;END' />
      </column>
      <column caption='CC Volume Share' datatype='real' name='[Calculation_0014355628331087]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [payment_type] = &apos;credit_card&apos; THEN [payment_value] END) / SUM([payment_value])' />
      </column>
      <column caption='Current Boleto Lag ' datatype='integer' name='[Calculation_0014355629236304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;   AND [payment_type] = &apos;boleto&apos; &#10;THEN DATEDIFF(&apos;hour&apos;, [order_purchase_timestamp], [order_approved_at]) &#10;END' />
      </column>
      <column caption='Previous Boleto Lag' datatype='integer' name='[Calculation_0014355630616657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) &#10;   AND [payment_type] = &apos;boleto&apos; &#10;THEN DATEDIFF(&apos;hour&apos;, [order_purchase_timestamp], [order_approved_at]) &#10;END' />
      </column>
      <column caption='YoY % Boleto Lag' datatype='real' name='[Calculation_0014355630706770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN &#10;    NULL &#10;ELSE &#10;    (AVG([Calculation_0014355629236304]) - AVG([Calculation_0014355630616657])) &#10;    / AVG([Calculation_0014355630616657])&#10;END' />
      </column>
      <column caption='Current Year Instant Volume' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014355632611411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] &#10;   AND [payment_type] IN (&apos;debit_card&apos;, &apos;voucher&apos;) &#10;THEN [payment_value] &#10;END' />
      </column>
      <column caption='Previous Year Instant Volume' datatype='real' name='[Calculation_0014355632705620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)&#10;   AND [payment_type] IN (&apos;debit_card&apos;, &apos;voucher&apos;) &#10;THEN [payment_value] &#10;END' />
      </column>
      <column caption='Current Year Instant Cash Ratio' datatype='real' name='[Calculation_0014355632906325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0014355632611411]) / SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [payment_value] END)' />
      </column>
      <column caption='Previous Year Instant Cash Ratio ' datatype='real' name='[Calculation_0014355633008726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0014355632705620]) / SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) THEN [payment_value] END)' />
      </column>
      <column caption='YoY Instant Cash Ratio % Change' datatype='real' name='[Calculation_0014355633143895]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN &#10;    NULL &#10;ELSE &#10;    ([Calculation_0014355632906325] - [Calculation_0014355633008726]) &#10;    / [Calculation_0014355633008726]&#10;END' />
      </column>
      <column caption='Cancelled GMV Leakage' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014424814227471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;canceled&apos; THEN [price] END)' />
      </column>
      <column caption='Financial Leakage Rate' datatype='real' name='[Calculation_0014424814436368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0014424814227471] / SUM( IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] END)' />
      </column>
      <column caption='Monthly Cancelled Volume by Reason' datatype='string' name='[Calculation_0014424814555153]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [order_status] = &apos;canceled&apos; THEN&#10;&#9;IF [payment_type] = &apos;boleto&apos; THEN &apos;Unpaid Boleto Slip&apos;&#10;    ELSEIF [payment_type] = &apos;credit_card&apos; THEN &apos;Credit Card Decline / Timeout&apos;&#10;    ELSE &apos;Other Cancelled Methods&apos;&#10;    END&#10;  END' />
      </column>
      <column caption='Current Year Boleto Leakage Share' datatype='real' name='[Calculation_0014425015566493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;canceled&apos; AND [payment_type] = &apos;boleto&apos; THEN [price] END)&#10;/&#10;[Calculation_0014562451226760]' />
      </column>
      <column caption='Previous Year Boleto Leakage Share' datatype='real' name='[Calculation_0014425015931038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) AND [order_status] = &apos;canceled&apos; AND [payment_type] = &apos;boleto&apos; THEN [price] END)&#10;/&#10;[Calculation_0014562451587210]' />
      </column>
      <column caption='YoY Boleto Leakage Share Change' datatype='real' name='[Calculation_0014425016090783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;NULL&#10;ELSE&#10;([Calculation_0014425015566493] - [Calculation_0014425015931038]) / [Calculation_0014425015931038]&#10;END' />
      </column>
      <column caption='Current Year Revenue' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014559300214829]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [order_status] = &apos;delivered&apos; THEN ([price]+[freight_value]) END)' />
      </column>
      <column caption='Previous Year Revenue' datatype='real' name='[Calculation_0014559300448302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] - 1 AND [order_status] = &apos;delivered&apos; THEN ([price]+[freight_value]) END)' />
      </column>
      <column caption='YoY % Change Revenue' datatype='real' name='[Calculation_0014559300612143]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;&#9;NULL // Or handle as baseline&#10;ELSE&#10;([Calculation_0014559300214829] - [Calculation_0014559300448302]) / [Calculation_0014559300448302]&#10;END' />
      </column>
      <column caption='Keep Active Comparison Years' datatype='boolean' name='[Calculation_0014559309459505]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;OR&#10;YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)' />
      </column>
      <column caption='Sparkline Line Color' datatype='string' name='[Calculation_0014559309910066]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN &quot;Selected Year&quot;&#10;ELSEIF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) THEN &quot;Prior Year&quot;&#10;END' />
      </column>
      <column caption='Current Year Orders' datatype='string' name='[Calculation_0014559314034739]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [order_id] END' />
      </column>
      <column caption='Previous Year Orders' datatype='string' name='[Calculation_0014559314264116]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) THEN [order_id] END' />
      </column>
      <column caption='YoY Orders % Change' datatype='real' name='[Calculation_0014559314645045]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 0014559299325996] = 2017 THEN&#10;NULL // Or handle as baseline&#10;ELSE (COUNT([Calculation_0014559314034739]) - COUNT([Calculation_0014559314264116])) / COUNT([Calculation_0014559314264116])&#10;END' />
      </column>
      <column caption='Current Year Merch Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014559317827638]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [price] END)' />
      </column>
      <column caption='Previous Year Merch Value' datatype='real' name='[Calculation_0014559318024247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1) THEN [price] END)' />
      </column>
      <column caption='YoY Merch Value % Change' datatype='real' name='[Calculation_0014559318810681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;&#9;NULL // Or handle as baseline&#10;ELSE&#10;&#9;([Calculation_0014559317827638] - [Calculation_0014559318024247]) / [Calculation_0014559318024247]&#10;  END' />
      </column>
      <column caption='Current Year Freight Value' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[Calculation_0014559324897350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [freight_value] END)' />
      </column>
      <column caption='Previous Year Freight Value' datatype='real' name='[Calculation_0014559324966983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1) THEN [freight_value] END)' />
      </column>
      <column caption='YoY Freight Value % Change' datatype='real' name='[Calculation_0014559325274184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017 THEN&#10;NULL // Or handle as baseline&#10;ELSE ([Calculation_0014562508836887] - [Calculation_0014562508951576]) / [Calculation_0014562508951576]&#10;END' />
      </column>
      <column caption='Current Year FPR' datatype='real' name='[Calculation_0014559353548883]' role='measure' type='quantitative'>
