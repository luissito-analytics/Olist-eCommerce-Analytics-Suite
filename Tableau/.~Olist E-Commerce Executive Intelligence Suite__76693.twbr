            <column caption='Price' datatype='real' default-format='c&quot;R$&quot;#,##0.00;-&quot;R$&quot;#,##0.00' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0014562451226760]' derivation='User' name='[usr:Calculation_0014562451226760:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0014562451738765]' derivation='User' name='[usr:Calculation_0014562451738765:qk]' pivot='key' type='quantitative' />
