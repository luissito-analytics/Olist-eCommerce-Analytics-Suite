    <worksheet name='BAN - Late Delivery Rate'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#555555' italic='true'>Late Delivery Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <repository-location derived-from='http://localhost:9100/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490/BAN-LateDeliveryRate?rev=' id='BAN-LateDeliveryRate' path='/workbooks/OlistE-CommerceAnalyticsDashboard_17925748216490' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Current Year Late Delivery Rate' datatype='real' name='[Calculation_0015456558383109]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;&#9;AND NOT ISNULL([order_delivered_customer_date])&#10;&#9;AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;  THEN [order_id] END)&#10;/&#10;COUNTD(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;&#9;AND [order_status] = &apos;delivered&apos;&#10;&#9;AND NOT ISNULL([order_delivered_customer_date])&#10;  THEN [order_id] END)' />
            </column>
            <column caption='Previous Year Late Delivery Rate' datatype='real' name='[Calculation_0015456558829574]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_delivered_customer_date])&#10;AND [order_delivered_customer_date] &gt; [order_estimated_delivery_date]&#10;    THEN [order_id] END)&#10;/&#10;COUNTD(IF YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996]-1)&#10;AND [order_status] = &apos;delivered&apos;&#10;AND NOT ISNULL([order_delivered_customer_date])&#10;&#9;THEN [order_id] END)' />
            </column>
            <column caption='YoY Late Delivery Rate Change' datatype='real' name='[Calculation_0015456558952455]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([Parameters].[Parameter 0014559299325996]) = 2017&#10;THEN NULL&#10;ELSE ([Calculation_0015456558383109] - [Calculation_0015456558829574]) / [Calculation_0015456558829574]&#10;END' />
            </column>
            <column caption='Order Delivered Customer Date' datatype='datetime' name='[order_delivered_customer_date]' role='dimension' type='ordinal' />
            <column caption='Order Estimated Delivery Date' datatype='datetime' name='[order_estimated_delivery_date]' role='dimension' type='ordinal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Order Status' datatype='string' name='[order_status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0015456558383109]' derivation='User' name='[usr:Calculation_0015456558383109:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0015456558952455]' derivation='User' name='[usr:Calculation_0015456558952455:qk]' pivot='key' type='quantitative' />
