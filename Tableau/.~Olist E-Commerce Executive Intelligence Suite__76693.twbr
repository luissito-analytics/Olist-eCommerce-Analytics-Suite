            <zone h='18241' id='752' param='vert' type-v2='layout-flow' w='22708' x='74948' y='28241'>
              <zone forceUpdate='true' h='4908' id='753' type-v2='text' w='22708' x='74948' y='28241'>
                <formatted-text>
                  <run bold='true'>Retention &amp; Customer Lifecycle:  </run>
                  <run>Pairs top-level volume, CSAT, and repeat purchase KPIs with an RFM segmentation breakdown </run>
                  <run italic='true'>(see RFM customer segmentation rules) </run>
                  <run>and monthly 1-star friction trajectories</run>
                  <run italic='true'>.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='4908' id='754' type-v2='text' w='22708' x='74948' y='33149'>
                <formatted-text>
                  <run bold='true'>Delay Tolerance &amp; Payment Correlation:  </run>
                  <run>Maps star rating distributions against delivery delay brackets to pinpoint exact customer tolerance tipping points, alongside CSAT performance across payment types and installment tiers.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#444444' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='4908' id='755' type-v2='text' w='22708' x='74948' y='38057'>
                <formatted-text>
                  <run bold='true'>Product &amp; Regional Sentiment Outliers:  </run>
                  <run>Contrasts the Top 5 highest-rated and Bottom 5 most friction-heavy product categories alongside state-level CSAT rankings.</run>
                </formatted-text>
