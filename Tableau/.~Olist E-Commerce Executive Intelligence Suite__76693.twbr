          </zone>
          <zone fixed-size='63' forceUpdate='true' h='6574' id='747' is-fixed='true' type-v2='text' w='24375' x='73281' y='19537'>
            <formatted-text>
              <run bold='true'>Strategic Objective:  </run>
              <run>Connects post-purchase customer sentiment and retention behavior directly to fulfillment reliability, payment structures, and product quality.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#444444' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
