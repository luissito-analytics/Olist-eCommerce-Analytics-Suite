      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders.csv+ (Multiple Connections)' name='federated.0ahelyx13kq92b10yuz131bg1ek3' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year' datatype='integer' default-format='n0;-0' name='[Parameter 0014559299325996]' param-domain-type='list' role='measure' type='quantitative' value='2018'>
              <calculation class='tableau' formula='2018' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ahelyx13kq92b10yuz131bg1ek3'>
            <column caption='Keep Active Comparison Years' datatype='boolean' name='[Calculation_0014559309459505]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;OR&#10;YEAR([order_purchase_timestamp]) = ([Parameters].[Parameter 0014559299325996] - 1)' />
            </column>
            <column caption='Installment Bracket' datatype='string' name='[Calculation_0014833250615359]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [payment_installments] = 1 THEN &quot;1x (Immediate)&quot;&#10;ELSEIF [payment_installments] &gt;= 2 AND [payment_installments] &lt;= 3 THEN &quot;2-3x (Short Term)&quot;&#10;ELSEIF [payment_installments] &gt;= 4 AND [payment_installments] &lt;= 6 THEN &quot;4-6x (Medium Term)&quot;&#10;ELSEIF [payment_installments] &gt;= 7 THEN &quot;7-10+x (Long Term)&quot;&#10;END' />
            </column>
            <column caption='Installment Volume %' datatype='real' name='[Calculation_0014905811804166]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [payment_type] = &apos;credit_card&apos; &#10;THEN [payment_value] END)&#10;/ &#10;TOTAL(SUM(&#10;IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] AND [payment_type] = &apos;credit_card&apos; THEN [payment_value] END))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Installment Risk Color' datatype='string' name='[Calculation_0014905812258823]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0014833250615359] = &apos;7-10+x (Long Term)&apos; THEN &apos;High Cash Deferral&apos;&#10;ELSE &apos;Standard&apos;&#10;END' />
            </column>
            <column caption='Current Year Payment Value' datatype='real' name='[Calculation_1350130400096257]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996] THEN [payment_value] END)' />
            </column>
            <column caption='Current Year Credit Card Payment Value' datatype='real' name='[Calculation_1350130405728258]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([order_purchase_timestamp]) = [Parameters].[Parameter 0014559299325996]&#10;AND [payment_type] = &apos;credit_card&apos;&#10;THEN [payment_value]&#10;END)' />
            </column>
            <column-instance column='[Calculation_0014559309459505]' derivation='None' name='[none:Calculation_0014559309459505:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0014833250615359]' derivation='None' name='[none:Calculation_0014833250615359:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0014905812258823]' derivation='None' name='[none:Calculation_0014905812258823:nk]' pivot='key' type='nominal' />
            <column caption='Order Purchase Timestamp' datatype='datetime' name='[order_purchase_timestamp]' role='dimension' type='ordinal' />
            <column caption='Payment Installments' datatype='integer' name='[payment_installments]' role='measure' type='ordinal' />
